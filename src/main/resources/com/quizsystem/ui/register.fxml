<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizsystem.ui.RegisterController">
    <GridPane alignment="CENTER" hgap="10" vgap="10" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20"/>
        </padding>
        <Label text="Quiz System - Register" styleClass="title-label" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="0"/>
        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200"/>
        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="200"/>
        <TextField fx:id="visiblePasswordField" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="200" visible="false" managed="false"/>
        <CheckBox fx:id="showPasswordCheckBox" text="Show Password" onAction="#togglePasswordVisibility" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="200"/>
        <Button text="Register" onAction="#handleRegistrationSubmit" styleClass="button" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.halignment="CENTER"/>
        <Button text="Back to Login" onAction="#handleBackToLogin" styleClass="button" GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.halignment="CENTER"/>
        <Button fx:id="toggleDarkModeButton" text="Toggle Dark Mode" onAction="#toggleDarkMode" styleClass="button" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="6" GridPane.halignment="CENTER"/>
        <Label fx:id="messageLabel" styleClass="error-label" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="7"/>
    </GridPane>
</AnchorPane>
