<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizsystem.ui.ViewQuestionsController" alignment="CENTER" spacing="10" maxWidth="600" layoutX="100" layoutY="20">
    <Label text="View Questions" styleClass="title-label"/>
    <ListView fx:id="questionListView" prefHeight="300"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Toggle Dark Mode" onAction="#toggleDarkMode" styleClass="button"/>
        <Button text="Back to Dashboard" onAction="#handleBackToDashboard" styleClass="button"/>
    </HBox>
    <Label fx:id="messageLabel" text="" wrapText="true" styleClass="error-label"/>
</VBox>
