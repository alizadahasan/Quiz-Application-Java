<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ToggleGroup?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizsystem.ui.QuizController" alignment="CENTER" spacing="10" maxWidth="600" layoutX="100" layoutY="20">
    <fx:define>
        <ToggleGroup fx:id="answerGroup"/>
    </fx:define>
    <Label fx:id="quizTitleLabel" styleClass="title-label"/>
    <Label fx:id="questionLabel" text="Question" wrapText="true"/>
    <Label fx:id="feedbackLabel" text="" wrapText="true" styleClass="feedback-label"/>
    <RadioButton fx:id="optionA" toggleGroup="$answerGroup"/>
    <RadioButton fx:id="optionB" toggleGroup="$answerGroup"/>
    <RadioButton fx:id="optionC" toggleGroup="$answerGroup"/>
    <RadioButton fx:id="optionD" toggleGroup="$answerGroup"/>
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="prevButton" text="Previous" onAction="#handlePreviousQuestion" styleClass="button"/>
        <Button fx:id="nextButton" text="Next" onAction="#handleNextQuestion" styleClass="button"/>
        <Button fx:id="submitButton" text="Submit Quiz" onAction="#handleSubmitQuiz" styleClass="button"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="toggleDarkModeButton" text="Toggle Dark Mode" onAction="#toggleDarkMode" styleClass="button"/>
        <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBackToDashboard" styleClass="button"/>
    </HBox>
    <Label fx:id="messageLabel" text="" wrapText="true" styleClass="error-label"/>
</VBox>
